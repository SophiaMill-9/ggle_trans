# Supabase (same as Cloudflare Worker secrets)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Google credentials — RECOMMENDED: save DevTools cURL to curl.txt (see below)
# Do NOT paste masked values from the dashboard (they contain … ellipsis)
# GOOGLE_XSRF_TOKEN=
# TRANSPARENCY_COOKIE=

# curl.txt: DevTools → adstransparency.google.com → Network → SearchCreatives
#           → right-click → Copy as cURL → paste entire command into curl.txt
